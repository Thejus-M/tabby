# Where shared splits are stored, and how long they live.
DATABASE_PATH=tabby.db
SHARE_TTL_DAYS=30

# Per-IP limits (requests per minute). 0 disables, for local testing only.
SCAN_RATE_LIMIT_PER_MIN=3
SHARE_RATE_LIMIT_PER_MIN=10

# Local OCR (RapidOCR on CPU). Scans run one at a time by default.
# OCR_MAX_CONCURRENCY=1
# OCR_TIMEOUT_S=30
# OCR_QUEUE_WAIT_S=15
# OCR_THREADS=0
